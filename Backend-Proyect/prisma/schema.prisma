// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int       @id @default(autoincrement())
  nombres             String    @db.VarChar(100)
  apellidos           String    @db.VarChar(100)
  dni                 String    @db.VarChar(8)
  fecha_nacimiento    DateTime  @db.Date
  email               String    @db.VarChar(150)
  password_hash       String    @db.VarChar(255)
  role                String?   @default("user") @db.VarChar(20)
  terms_accepted_at   DateTime  @db.Timestamptz
  created_at          DateTime? @default(now()) @db.Timestamptz
  email_verified      Boolean?

  email_verification_tokens EmailVerificationToken[]
  interactions_sent       Interaction[]            @relation("InteractionUser")
  interactions_received   Interaction[]            @relation("InteractionTargetUser")
  matches_as_user1        Match[]                  @relation("MatchUser1")
  matches_as_user2        Match[]                  @relation("MatchUser2")
  messages_sent           Message[]

  @@map("users")
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  created_at DateTime  @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  token_hash String    @db.VarChar(64)
  used_at    DateTime? @db.Timestamptz(6)
  user_id    Int

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Interaction {
  id             Int       @id @default(autoincrement())
  user_id        Int?
  target_user_id Int?
  type           String?   @db.VarChar(10)
  created_at     DateTime? @default(now()) @db.Timestamptz

  user        User? @relation("InteractionUser", fields: [user_id], references: [id], onDelete: Cascade)
  target_user User? @relation("InteractionTargetUser", fields: [target_user_id], references: [id], onDelete: Cascade)

  @@map("interactions")
}

model Match {
  id         Int       @id @default(autoincrement())
  user1_id   Int?
  user2_id   Int?
  seen       Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz

  user1    User?     @relation("MatchUser1", fields: [user1_id], references: [id], onDelete: Cascade)
  user2    User?     @relation("MatchUser2", fields: [user2_id], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("matches")
}

model Message {
  id         Int       @id @default(autoincrement())
  match_id   Int?
  sender_id  Int?
  content    String    @db.Text
  created_at DateTime? @default(now()) @db.Timestamptz

  match  Match? @relation(fields: [match_id], references: [id], onDelete: Cascade)
  sender User?  @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@map("messages")
}